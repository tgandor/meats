FROM nvidia/cuda:12.8.1-base-ubuntu24.04

RUN apt-get update && apt-get upgrade -y
RUN DEBIAN_FRONTEND="noninteractive" TZ="Europe/Warsaw" apt-get install -y ffmpeg python3 python3-opencv \
    python-is-python3 python3-pip python3-tqdm pipx

# for manual _work_ this _works_ like this:
# docker run --runtime=nvidia --rm -it -v $(pwd)/:/work ffmpycu bash
RUN mkdir /work
WORKDIR /work

# run build from ~/meats as:
# docker build -f installer/ffmpeg_python_container/Dockerfile.cuda . -t ffmpycu
COPY . /root/meats
